# ---------------------------------------------------------------------------
# JARVIS configuration
#
# Copy to .env and fill in what you have. Every value is optional: the platform
# starts with none of them set and reports each missing capability honestly
# rather than pretending it is available.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
# SQLite needs no configuration. For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/jarvis
# DATABASE_URL=sqlite+aiosqlite:///./jarvis.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Model providers --------------------------------------------------------
# Configure at least one so agents can execute tasks.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# Point any OpenAI-compatible provider at a self-hosted gateway or proxy:
# OPENAI_BASE_URL=https://my-gateway.example.com/v1
# DEEPSEEK_BASE_URL=
# MISTRAL_BASE_URL=
# GROQ_BASE_URL=
# OPENROUTER_BASE_URL=
# ANTHROPIC_BASE_URL=
# GEMINI_BASE_URL=

# Local models require no key, only a running daemon.
OLLAMA_BASE_URL=http://localhost:11434

# --- Coding engines ---------------------------------------------------------
# OpenHands cloud or self-hosted app server.
# OPENHANDS_API_KEY=
OPENHANDS_BASE_URL=https://app.all-hands.dev
# OpenCode runs locally; start its server before creating sessions.
OPENCODE_BASE_URL=http://localhost:4096

# --- Source control ---------------------------------------------------------
# GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# --- Research ---------------------------------------------------------------
# One of these enables real web search.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# SERPER_API_KEY=

# --- Voice ------------------------------------------------------------------
# Without this, the browser's built-in speech APIs are used.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# --- Deployment -------------------------------------------------------------
# These are preparation-only; JARVIS never deploys without approval.
# VERCEL_TOKEN=
# RAILWAY_TOKEN=
